PUBLIC_ORIGIN=http://localhost:8789
PORT=8789
RPC_URL=https://testnet-rpc.monad.xyz
# Set these after deploying your own policy; zero addresses disable setup.
POLICY_ADDRESS=0x0000000000000000000000000000000000000000
POLICY_CODE_HASH=
MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
# Choose your own credentials locally. Blank credentials disable site login.
WORKSHOP_USERNAME=
WORKSHOP_PASSWORD=
DB_PATH=workshop.sqlite
KEYS_FILE=secrets/workshop.json
CODEX_RUNNER_URL=http://127.0.0.1:8790
CODEX_MODEL=gpt-5.6-luna

# Optional Mera EIP-7702 mode; deploy with scripts/deploy-mera.ts first.
MERA_IMPLEMENTATION=0x0000000000000000000000000000000000000000
MERA_CODE_HASH=

# Gasless mode: predecessor accounting and the funded owner-action helper.
MERA_PREVIOUS_IMPLEMENTATION=0x0000000000000000000000000000000000000000
GASLESS_ADDRESS=0x0000000000000000000000000000000000000000
GASLESS_CODE_HASH=
