{
  "name": "kuru-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "api": "node --import tsx apps/server/src/api.ts",
    "worker": "node --import tsx apps/server/src/worker.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "test:contracts": "cd contracts && forge test",
    "abi": "node --import tsx scripts/abi.ts",
    "preflight": "node --import tsx scripts/preflight.ts",
    "deploy:contract": "node --import tsx scripts/deploy.ts",
    "liquidity": "node --import tsx scripts/liquidity.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@tanstack/react-query": "^5.90.0",
    "@toxicflow-labs/ts-sdk": "0.0.1",
    "fastify": "^5.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "viem": "^2.37.0",
    "wagmi": "^2.16.9",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "license": "MIT"
}
